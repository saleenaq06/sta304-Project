X <- c(6.5, 7.1, 7.4, 6.4, 7.4, 8.3, 7.4, 6.1, 5.2, 6.2)
Y <- c(50, 63, 38, 50, 50, 81, 50, 44, 13, 25)
plot(X, Y, xlab = "Yds/Att", ylab = "WinPct",
main = "Passing Yards per Attempt vs Win Percentage")
model <- lm(Y ~ X)
summary(model)
# Data
X <- c(3.4, 3.3, 3.4, 3.6, 3.2, 3.8, 3.8, 2.6, 2.7, 4.0, 2.5)
Y <- c(3.5, 3.4, 3.9, 3.7, 2.9, 2.8, 3.6, 2.6, 2.3, 4.0, 2.5)
# Scatter diagram
plot(X, Y, xlab = "Speed of Execution", ylab = "Satisfaction",
main = "Satisfaction vs Speed of Execution")
# Fit the model
model <- lm(Y ~ X)
summary(model)
# MLE of sigma^2 = SSE / n  (note: this differs from R's default MSE = SSE/(n-2))
n <- length(Y)
SSE <- sum(residuals(model)^2)
sigma2_mle <- SSE / n
sigma2_mle
